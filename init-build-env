# shellcheck shell=bash
# (sourced file, not executable: no shebang on purpose)
BASEDIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

export BITBAKEDIR="${BASEDIR}/meta-voltumna/bitbake"
export TEMPLATECONF="${BASEDIR}/conf/templates/default"

export DISTRO="ec"
export MACHINE
export SDKMACHINE

# BB_ENV_EXTRAWHITE was removed upstream; extend (do not reset)
# BB_ENV_PASSTHROUGH_ADDITIONS so caller additions survive.
DESCRIBE=$(git -C "${BASEDIR}" describe --always --dirty || true)
IMAGE_VERSION=$(echo "$DESCRIBE" | sed -n 's/[0-9a-zA-Z]*-[0-9]*\.[0-9]*\(.*\)/\1/p')
export IMAGE_VERSION

# The hash equivalence DB must sit with the shared sstate cache: a per-build
# DB means a build can only reuse equivalences it recorded itself.
if [[ -n "${SSTATE_DIR:-}" ]]; then
    export BB_HASHSERVE_DB_DIR="${BB_HASHSERVE_DB_DIR:-$SSTATE_DIR}"
fi

export BB_ENV_PASSTHROUGH_ADDITIONS="${BB_ENV_PASSTHROUGH_ADDITIONS:-} IMAGE_VERSION DL_DIR SSTATE_DIR BB_HASHSERVE_DB_DIR"
source "${BASEDIR}/meta-voltumna/openembedded-core/oe-init-build-env" build "$@"
