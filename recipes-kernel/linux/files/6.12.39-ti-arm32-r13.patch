+	#size-cells = <0>;
+
+	touchscreen@41 {
+		compatible = "ilitek,ili251x";
+		reg = <0x41>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&dsi0_gpio_pins_default>;
+		reset-gpios = <&main_gpio0 98 GPIO_ACTIVE_LOW>;
+		interrupt-parent = <&main_gpio0>;
+		interrupts = <108 IRQ_TYPE_EDGE_FALLING>;
