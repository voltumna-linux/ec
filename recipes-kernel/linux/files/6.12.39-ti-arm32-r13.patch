+    channel@1 {
+        symlink = "bone/spi/6.1"; /* /dev/bone/spi/6.1 */
+        compatible = "rohm,dh2228fv";
+        reg = <1>;  /* CE1 */
+        spi-max-frequency = <125000000>;
+    };
+
+};
