+CONFIG_INDIRECT_PIO=n
+CONFIG_QUOTA=n
+
+CONFIG_XDP_SOCKETS=n
+CONFIG_COMMON_CLK_VC3=m
+
+# Disable ARMv8.1+ architecture features. TI K3 processors
+# are based on ARMv8.0, and these features are not applicable.
+CONFIG_ARM64_CNP=n
+CONFIG_ARM64_HW_AFDBM=n
