Subject: [PATCH] drivers: adapt callbacks to the 6.6 kernel API

Upstream builds against newer kernels where platform_driver.remove
returns void and the IIO write_event_config hook takes a bool state.
The 6.6 kernel this module is built against still uses the older API:
platform_driver.remove must return int, and write_event_config takes an
int state.  Building against 6.6 otherwise fails with
-Werror=incompatible-pointer-types on every .remove initializer and on
hub_write_event_config.

Switch the five platform remove callbacks back to returning int and
change hub_write_event_config's state argument to int.

Upstream-Status: Pending
---
 hls-foc-periodic.c | 3 ++-
 hls-pwm-gen.c      | 3 ++-
 hls-qei-axi.c      | 3 ++-
 hls-svpwm-duty.c   | 3 ++-
 xilinx-adc-hub.c   | 5 +++--
 5 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/hls-foc-periodic.c b/hls-foc-periodic.c
index 7e5e41b..b5b2bcb 100644
--- a/hls-foc-periodic.c
+++ b/hls-foc-periodic.c
@@ -1006,26 +1006,27 @@ static int foc_probe(struct platform_device *pdev)
 	ret = iio_device_register(indio_dev);
 	if (ret < 0)
 		return ret;
 
 	dev_info(&pdev->dev, "Successfully registered device FOC");
 	platform_set_drvdata(pdev, indio_dev);
 
 	return 0;
 }
 
-static void foc_remove(struct platform_device *pdev)
+static int foc_remove(struct platform_device *pdev)
 {
 	struct iio_dev *indio_dev = platform_get_drvdata(pdev);
 
 	iio_device_unregister(indio_dev);
 	/* clock is disabled automatically by devm_clk_get_enabled() devres */
+	return 0;
 }
 
 static struct platform_driver foc_drv = {
 	.probe = foc_probe,
 	.remove = foc_remove,
 	.driver = {
 		.name = "hls-foc-periodic",
 		.of_match_table = of_match_ptr(foc_ids),
 	},
 };
