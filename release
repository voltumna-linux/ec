#!/usr/bin/env bash

set -euo pipefail
trap 'echo "Errore alla riga $LINENO"' ERR

. "$(dirname -- "${BASH_SOURCE[0]}")/bake"

exec 3<<< "$DATI"

while read -r -u 3 machine type image outputdir format; do
    export MACHINE="$machine"
    DDIR="tmp/deploy/images/${machine}"
    case "$type" in
        "image")
            nice bitbake -k "$image"
            case "$format" in
                "tar")
                    for archive in net os; do
                        artifact=$(readlink -e -- "${DDIR}/${image}-${machine}.${archive}.tar")
                        xz -cT0 "$artifact" > "${1}/${outputdir}/$(basename -- "$artifact").xz"
                    done
                    ;;
                "wic")
                    artifact=$(readlink -e -- "${DDIR}/${image}-${machine}.wic")
                    IMAGE_NAME=$(basename -- "$artifact" .wic)
                    if [ -f "${artifact}.bmap" ]; then
                        cp "${artifact}.bmap" "${1}/${outputdir}/${IMAGE_NAME}.img.bmap"
                    fi
                    xz -cT0 "$artifact" > "${1}/${outputdir}/${IMAGE_NAME}.img.xz"
                    ;;
                *)
                    printf 'Format unknown: %s\n' "$format" >&2
                    exit 1
                    ;;
            esac
            ;;
        "sdk")
            nice bitbake -k "$image" -c populate_sdk
            case "$format" in
                "sh")
                    cp tmp/deploy/sdk/"${image}-x86_64-${machine}-"*.sh "${1}/${outputdir}"
                    ;;
                *)
                    printf 'Format unknown: %s\n' "$format" >&2
                    exit 1
                    ;;
            esac
            ;;
        *)
            printf 'Type unknown: %s\n' "$type" >&2
            exit 1
            ;;
    esac
done

exec 3<&-
